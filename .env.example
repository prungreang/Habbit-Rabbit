# ── Site ──────────────────────────────────────────────────────
# Used for canonical URLs, OG metadata, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# ── Supabase (optional) ───────────────────────────────────────
# Leave these empty to run the app in local demo mode.
# Fill them in and the whole app switches to Supabase + Google login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the contact form so anonymous visitors can write.
SUPABASE_SERVICE_ROLE_KEY=

# ── Umami analytics (optional) ────────────────────────────────
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
